        "jsCode": "const raw = $input.first().json;\nconst answer = typeof raw.message?.content === 'string' ? raw.message.content.trim() : '';\nif (!answer) return [{json:{status:502, error:'Модель не ответила. Проверьте, что Ollama запущена и модель скачана.'}}];\nreturn [{json:{status:200, answer, model:raw.model ?? 'qwen2.5:1.5b'}}];"
      },
